          "version": 3,
          "body": "<style>\n  :root {--brown: #2e1d16;--brown-mid: #4a3228;--brown-soft: #6b4a3a;--mint: #8fe3c4;--mint-deep: #4fbf9a;--cream: #f6f1ea;--paper: #fffdfa;--line: rgba(46, 29, 22, 0.14);--shadow: 0 18px 40px -24px rgba(46, 29, 22, 0.45)}\n\n  * {box-sizing: border-box}\n\n  html {-webkit-text-size-adjust: 100%}\n\n  body {margin: 0;background: var(--cream);color: var(--brown);font-family: \"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", \"Noto Sans SC\", system-ui, sans-serif;font-size: 16px;line-height: 1.7;letter-spacing: 0.01em}\n\n  a {color: inherit}\n\n  .wrap {width: 100%;max-width: 1120px;margin: 0 auto;padding: 0 22px}\n\n  /* ---------- 首屏 ---------- */\n  .hero {background: var(--brown);color: var(--cream);padding: 34px 0 64px;position: relative;overflow: hidden}\n\n  .hero::after {content: \"\";position: absolute;right: -140px;top: -140px;width: 380px;height: 380px;border-radius: 50%;background: radial-gradient(circle at 35% 35%, rgba(143, 227, 196, 0.30), rgba(143, 227, 196, 0) 70%);pointer-events: none}\n\n  .brandline {display: flex;align-items: baseline;gap: 14px;flex-wrap: wrap;font-size: 13px;letter-spacing: 0.22em;text-transform: uppercase;color: var(--mint)}\n\n  .brandline span:last-child {color: rgba(246, 241, 234, 0.5);letter-spacing: 0.12em}\n\n  .anchors {display: flex;flex-wrap: wrap;gap: 8px;margin: 26px 0 0;padding: 0;list-style: none}\n\n  .anchors a {display: inline-block;padding: 7px 15px;border: 1px solid rgba(143, 227, 196, 0.45);border-radius: 999px;font-size: 13.5px;color: var(--mint);text-decoration: none;transition: background 0.15s ease, color 0.15s ease}\n\n  .anchors a:hover,\n  .anchors a:focus-visible {background: var(--mint);color: var(--brown);border-color: var(--mint)}\n\n  .hero-grid {display: grid;grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);gap: 46px;align-items: start;margin-top: 44px;position: relative;z-index: 1}\n\n  h1 {margin: 0 0 18px;font-size: clamp(2.15rem, 5.2vw, 3.5rem);line-height: 1.15;font-weight: 800;letter-spacing: -0.01em}\n\n  h1 em {font-style: normal;color: var(--mint)}\n\n  .hero-lead {margin: 0;max-width: 30em;font-size: 1.02rem;color: rgba(246, 241, 234, 0.82)}\n\n  .hero-note {margin: 22px 0 0;padding-left: 14px;border-left: 3px solid var(--mint-deep);font-size: 0.9rem;color: rgba(246, 241, 234, 0.62);max-width: 30em}\n\n  .panel {background: var(--paper);color: var(--brown);border-radius: 22px;padding: 26px 24px 22px;box-shadow: var(--shadow)}\n\n  .panel h2 {margin: 0 0 4px;font-size: 1rem;letter-spacing: 0.06em}\n\n  .panel .panel-sub {margin: 0 0 18px;font-size: 0.83rem;color: var(--brown-soft)}\n\n  .panel dl {margin: 0;display: grid;gap: 0}\n\n  .panel .row {display: flex;justify-content: space-between;align-items: baseline;gap: 16px;padding: 11px 0;border-top: 1px solid var(--line);font-size: 0.92rem}\n\n  .panel .row:first-of-type {border-top: none}\n\n  .panel dt {color: var(--brown-soft)}\n\n  .panel dd {margin: 0;font-weight: 700;text-align: right}\n\n  .panel .jump {display: inline-block;margin-top: 18px;font-size: 0.88rem;font-weight: 700;color: var(--brown);text-decoration: none;border-bottom: 2px solid var(--mint-deep);padding-bottom: 2px}\n\n  .panel .jump:hover {color: var(--brown-soft)}\n\n  /* ---------- 通用区块 ---------- */\n  section {padding: 66px 0}\n\n  .sec-head {max-width: 40em;margin-bottom: 34px}\n\n  .eyebrow {display: block;font-size: 12.5px;letter-spacing: 0.24em;text-transform: uppercase;color: var(--mint-deep);margin-bottom: 10px;font-weight: 700}\n\n  h2 {margin: 0 0 12px;font-size: clamp(1.5rem, 3.1vw, 2.05rem);line-height: 1.3;letter-spacing: -0.005em}\n\n  h3 {margin: 0 0 8px;font-size: 1.08rem;line-height: 1.45}\n\n  .sec-head p {margin: 0;color: var(--brown-soft);font-size: 0.97rem}\n\n  /* ---------- 说明卡（大圆角软阴影） ---------- */\n  .cards {display: grid;grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));gap: 22px}\n\n  .card {background: var(--paper);border-radius: 20px;padding: 26px 24px;box-shadow: var(--shadow)}\n\n  .card .num {display: inline-flex;align-items: center;justify-content: center;width: 32px;height: 32px;border-radius: 11px;background: var(--mint);color: var(--brown);font-weight: 800;font-size: 14px;margin-bottom: 14px}\n\n  .card p {margin: 0;font-size: 0.94rem;color: var(--brown-soft)}\n\n  /* ---------- 套餐：单列大卡 ---------- */\n  #plans {background: var(--brown);color: var(--cream)}\n  #plans .eyebrow {color: var(--mint)}\n  #plans .sec-head p {color: rgba(246, 241, 234, 0.66)}\n\n  .plan-stack {display: grid;gap: 22px}\n\n  .plan {background: var(--paper);color: var(--brown);border-radius: 24px;padding: 28px 28px 26px;box-shadow: 0 22px 50px -30px rgba(0, 0, 0, 0.7);display: grid;grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);gap: 28px}\n\n  .plan.featured {background: var(--paper);border: 2px solid var(--mint-deep)}\n\n  .plan-top {display: flex;align-items: center;gap: 10px;flex-wrap: wrap;margin-bottom: 6px}\n\n  .plan-top h3 {margin: 0;font-size: 1.22rem}\n\n  .tag {font-size: 11.5px;letter-spacing: 0.1em;padding: 3px 9px;border-radius: 7px;background: var(--mint);color: var(--brown);font-weight: 700}\n\n  .price {margin: 12px 0 2px;font-size: 2rem;font-weight: 800;line-height: 1.1;letter-spacing: -0.01em}\n\n  .price small {font-size: 0.9rem;font-weight: 600;color: var(--brown-soft);margin-left: 4px}\n\n  .annual {margin: 0;font-size: 0.9rem;color: var(--brown-soft)}\n\n  .plan ul {margin: 0;padding: 0;list-style: none;display: grid;gap: 10px;align-content: start}\n\n  .plan li {position: relative;padding-left: 20px;font-size: 0.94rem;color: var(--brown)}\n\n  .plan li::before {content: \"\";position: absolute;left: 0;top: 0.62em;width: 8px;height: 8px;border-radius: 2px;background: var(--mint-deep)}\n\n  .plan-foot {margin: 22px 0 0;font-size: 0.83rem;color: rgba(246, 241, 234, 0.55)}\n\n  /* ---------- 使用步骤 ---------- */\n  .steps {display: grid;gap: 0;counter-reset: step}\n\n  .step {display: grid;grid-template-columns: 88px minmax(0, 1fr);gap: 20px;padding: 24px 0;border-top: 1px solid var(--line)}\n\n  .step:last-child {border-bottom: 1px solid var(--line)}\n\n  .step .idx {counter-increment: step;font-size: 1.9rem;font-weight: 800;color: var(--mint-deep);line-height: 1}\n\n  .step .idx::before {content: counter(step, decimal-leading-zero)}\n\n  .step p {margin: 0;color: var(--brown-soft);font-size: 0.95rem}\n\n  /* ---------- 客户端 ---------- */\n  #clients {background: #efe7dc}\n\n  .client-list {display: grid;grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));gap: 20px}\n\n  .client {background: var(--paper);border-radius: 18px;padding: 22px 22px 20px;box-shadow: var(--shadow)}\n\n  .client h3 {margin-bottom: 6px}\n\n  .client .meta {font-size: 0.78rem;letter-spacing: 0.12em;text-transform: uppercase;color: var(--mint-deep);font-weight: 700;margin-bottom: 10px;display: block}\n\n  .client p {margin: 0;font-size: 0.92rem;color: var(--brown-soft)}\n\n  .client .where {margin-top: 14px;font-size: 0.84rem;color: var(--brown);border-top: 1px dashed var(--line);padding-top: 10px}\n\n  /* ---------- FAQ ---------- */\n  details {background: var(--paper);border-radius: 16px;box-shadow: var(--shadow);margin-bottom: 12px;overflow: hidden}\n\n  details summary {cursor: pointer;padding: 18px 22px;font-weight: 700;font-size: 0.98rem;list-style: none;display: flex;justify-content: space-between;align-items:-center;gap: 16px}\n\n  details summary::-webkit-details-marker {display: none}\n\n  details summary::after {content: \"+\";font-size: 1.2rem;font-weight: 700;color: var(--mint-deep);line-height: 1;flex: none}\n\n  details[open] summary::after {content: \"–\"}\n\n  details .answer {padding: 0 22px 20px;font-size: 0.93rem;color: var(--brown-soft);border-top: 1px solid var(--line);padding-top: 16px;margin-top: 2px}\n\n  details .answer p {margin: 0 0 10px}\n  details .answer p:last-child {margin-bottom: 0}\n\n  /* ---------- 页脚 ---------- */\n  footer {background: var(--brown);color: rgba(246, 241, 234, 0.68);padding: 44px 0 50px;font-size: 0.9rem}\n\n  .foot-grid {display: flex;flex-wrap: wrap;gap: 26px;justify-content: space-between;align-items: flex-start}\n\n  .foot-brand {font-size: 1.05rem;font-weight: 800;color: var(--cream);letter-spacing: 0.04em}\n\n  footer p {margin: 8px 0 0;max-width: 34em}\n\n  footer a {color: var(--mint);text-decoration: none;border-bottom: 1px solid rgba(143, 227, 196, 0.4)}\n\n  footer a:hover {border-bottom-color: var(--mint)}\n\n  .foot-links {display: grid;gap: 6px}\n\n  /* ---------- 响应式 ---------- */\n  @media (max-width: 860px) {.hero-grid { grid-template-columns: minmax(0, 1fr);gap: 32px;margin-top: 34px;}\n    .plan { grid-template-columns: minmax(0, 1fr);gap: 18px;}\n    section { padding: 52px 0;}\n    .step { grid-template-columns: 56px minmax(0, 1fr);gap: 14px;}\n    .step .idx { font-size: 1.5rem;}}\n\n  @media (max-width: 480px) {\n    .hero {padding: 26px 0 48px}\n    .panel {padding: 22px 18px 18px;border-radius: 18px}\n    .plan {padding: 22px 20px;border-radius: 20px}\n    .price {font-size: 1.7rem}\n    details summary {padding: 16px 18px;font-size: 0.94rem}\n    details .answer {padding: 14px 18px 18px}\n  }\n</style><main>\n\n  <header class=\"hero\">\n    <div class=\"wrap\">\n      <div class=\"brandline\">\n        <span>讯达</span>\n        <span>订阅与使用说明</span>\n      </div>\n\n      <nav aria-label=\"页面目录\">\n        <ul class=\"anchors\">\n          <li><a href=\"#basics\">基本说明</a></li>\n          <li><a href=\"#plans\">套餐与价格</a></li>\n          <li><a href=\"#usage\">使用步骤</a></li>\n          <li><a href=\"#clients\">客户端</a></li>\n          <li><a href=\"#faq\">常见问题</a></li>\n        </ul>\n      </nav>\n\n      <div class=\"hero-grid\">\n        <div>\n          <h1>讯达：把<em>订阅</em><br>说清楚，再用起来</h1>\n          <p class=\"hero-lead\">\n            这一页只讲三件事：有哪些档位、每档给多少、怎么开始用。\n            价格、流量、设备数量都写在下面，不做含糊表述。\n          </p>\n          <p class=\"hero-note\">\n            本页未提及的能力不作承诺。遇到与页面不一致的情况，以你实际开通时确认的条款为准。\n          </p>\n        </div>\n\n        <aside class=\"panel\" aria-label=\"套餐速览\">\n          <h2>三档速览</h2>\n          <p class=\"panel-sub\">按月计价，另有年付价</p>\n          <dl>\n            <div class=\"row\">\n              <dt>基础版</dt>\n              <dd>¥15 / 月</dd>\n            </div>\n            <div class=\"row\">\n              <dt>旗舰版</dt>\n              <dd>¥35 / 月</dd>\n            </div>\n            <div class=\"row\">\n              <dt>团队版</dt>\n              <dd>¥85 / 月</dd>\n            </div>\n            <div class=\"row\">\n              <dt>设备上限</dt>\n              <dd>3 / 5 / 20 台</dd>\n            </div>\n            <div class=\"row\">\n              <dt>流量档位</dt>\n              <dd>100 / 300 / 1000 GB</dd>\n            </div>\n          </dl>\n          <a class=\"jump\" href=\"#plans\">看完整权益 →</a>\n        </aside>\n      </div>\n    </div>\n  </header>\n\n  <section id=\"basics\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"eyebrow\">基本说明</span>\n        <h2>先看四条，少走弯路</h2>\n        <p>订阅是周期制的。选档之前，把这几条确认一遍，比事后沟通省事。</p>\n      </div>\n      <div class=\"cards\">\n        <article class=\"card\">\n          <span class=\"num\">01</span>\n          <h3>周期从开通当天起算</h3>\n          <p>月付按自然月周期计，年付按十二个月计。周期结束后需要续订，未续订则停止服务，不会自动续。</p>\n        </article>\n        <article class=\"card\">\n          <span class=\"num\">02</span>\n          <h3>流量是每月重置的</h3>\n          <p>各档的流量额度在每个计费周期开始时重新计算，未用完的部分不累积到下一周期。</p>\n        </article>\n        <article class=\"card\">\n          <span class=\"num\">03</span>\n          <h3>设备数按同时在线算</h3>\n          <p>3 台、5 台、20 台指的是同一时刻在线的设备数量。换设备时先退出旧设备，再登入新设备。</p>\n        </article>\n        <article class=\"card\">\n          <span class=\"num\">04</span>\n          <h3>档位可以调整</h3>\n          <p>需要更多流量或更多设备位时，可联系支持人员说明当前档位与目标档位，具体处理方式以回复为准。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"eyebrow\">套餐与价格</span>\n        <h2>三档，逐条列清楚</h2>\n        <p>从低到高排列。流量、设备数、节点类型逐档递进，按实际用量挑，不必一次到位。</p>\n      </div>\n\n      <div class=\"plan-stack\">\n\n        <article class=\"plan\">\n          <div>\n            <div class=\"plan-top\">\n              <h3>基础版</h3>\n            </div>\n            <p class=\"price\">¥15<small>/ 月</small></p>\n            <p class=\"annual\">按年付仅需 ¥150 / 年</p>\n          </div>\n          <ul>\n            <li>每月 100GB 流量额度</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>常规节点池</li>\n            <li>基础流媒体解锁</li>\n          </ul>\n        </article>\n\n        <article class=\"plan featured\">\n          <div>\n            <div class=\"plan-top\">\n              <h3>旗舰版</h3>\n              <span class=\"tag\">推荐</span>\n            </div>\n            <p class=\"price\">¥35<small>/ 月</small></p>\n            <p class=\"annual\">按年付仅需 ¥350 / 年</p>\n          </div>\n          <ul>\n            <li>每月 300GB 流量额度</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点流媒体解锁</li>\n            <li>专线线路，针对游戏连接做延迟优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </article>\n\n        <article class=\"plan\">\n          <div>\n            <div class=\"plan-top\">\n              <h3>团队版</h3>\n            </div>\n            <p class=\"price\">¥85<small>/ 月</small></p>\n            <p class=\"annual\">按年付仅需 ¥850 / 年</p>\n          </div>\n          <ul>\n            <li>每月 1000GB 流量额度</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理对接</li>\n          </ul>\n        </article>\n\n      </div>\n\n      <p class=\"plan-foot\">\n        以上为页面对外列出的价格与权益。开通方式、付款渠道与发票事宜，请与支持人员确认后再操作。\n      </p>\n    </div>\n  </section>\n\n  <section id=\"usage\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"eyebrow\">使用步骤</span>\n        <h2>四步，从上到下走完</h2>\n        <p>顺序不能跳。前一步没确认，后面的配置容易白做。</p>\n      </div>\n\n      <div class=\"steps\">\n        <article class=\"step\">\n          <div class=\"idx\"></div>\n          <div>\n            <h3>确认档位与周期</h3>\n            <p>对照上面的三档，先估一下每月大概用多少流量、几台设备同时在线。年付比月付更省，但周期长，先用月付试一个月也合理。</p>\n          </div>\n        </article>\n\n        <article class=\"step\">\n          <div class=\"idx\"></div>\n          <div>\n            <h3>拿到你的订阅信息</h3>\n            <p>开通后你会收到一组订阅配置。它等同于账号凭证，不要转发到公开群组或截图发到社交平台。</p>\n          </div>\n        </article>\n\n        <article class=\"step\">\n          <div class=\"idx\"></div>\n          <div>\n            <h3>在客户端里导入配置</h3>\n            <p>按你使用的系统选择对应客户端，把订阅配置导入进去。不同客户端的导入入口位置不同，具体见下一节。导入后刷新一次，确认节点列表正常显示。</p>\n          </div>\n        </article>\n\n        <article class=\"step\">\n          <div class=\"idx\"></div>\n          <div>\n            <h3>连接并核对用量</h3>\n            <p>选择节点建立连接，先打开一个普通网页确认可用。之后在使用中留意流量消耗，接近额度时提前考虑是否调整档位。</p>\n          </div>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"eyebrow\">客户端</span>\n        <h2>按系统对号入座</h2>\n        <p>讯达不自建客户端。下面按平台说明通用的使用方式，安装包请从对应项目的官方渠道获取。</p>\n      </div>\n\n      <div class=\"client-list\">\n\n        <article class=\"client\">\n          <span class=\"meta\">Windows / macOS</span>\n          <h3>桌面端</h3>\n          <p>桌面端适合长时间在线的工作场景。导入订阅后可在节点列表中切换，建议保留两到三个备用节点。</p>\n          <p class=\"where\">获取方式：请从所选客户端项目的官方发布渠道下载。本页不提供安装包链接。</p>\n        </article>\n\n        <article class=\"client\">\n          <span class=\"meta\">Android / iOS</span>\n          <h3>移动端</h3>\n          <p>移动端切换网络较频繁，建议在流量与 Wi-Fi 之间切换后重新选择一次节点，避免连接停留在旧线路上。</p>\n          <p class=\"where\">获取方式：iOS 请在 App Store 中按客户端名称自行检索；Android 请从对应项目的官方渠道获取。</p>\n        </article>\n\n        <article class=\"client\">\n          <span class=\"meta\">路由器</span>\n          <h3>局域网共享</h3>\n          <p>团队版支持 20 台设备同时在线，适合在路由器层面统一配置。若在路由器上配置，请先在单机上验证订阅可用，再迁移到路由器。</p>\n          <p class=\"where\">获取方式：请在所选路由器固件的官方文档中查阅配置方法。本页不提供固件下载。</p>\n        </article>\n\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"eyebrow\">常见问题</span>\n        <h2>常被问到的八个问题</h2>\n        <p>点开任意一条查看回答。答案只覆盖本页能确认的范围。</p>\n      </div>\n\n      <details>\n        <summary>年付能省多少？</summary>\n        <div class=\"answer\">\n          <p>基础版月付 ¥15，年付 ¥150，相当于十个月的月付价格；旗舰版月付 ¥35，年付 ¥350；团队版月付 ¥85，年付 ¥850。</p>\n          <p>年付的优势是省下两个月，代价是一次锁定一整年。如果用量还不确定，先月付一个月观察实际消耗更稳妥。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>流量用超了会怎样？</summary>\n        <div class=\"answer\">\n          <p>各档流量为每月额度，未用完的部分不结转到下一周期。额度用尽后，本周期内的连接会受限。</p>\n          <p>如果经常提前用完，说明当前档位和你的实际用量不匹配，可以考虑升一档；偶尔超一点，可以等下个周期重置。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>三档的节点有区别吗？</summary>\n        <div class=\"answer\">\n          <p>有。基础版使用常规节点池；旗舰版可用全部节点，并包含针对游戏连接做延迟优化的专线线路；团队版使用专属高带宽节点。</p>\n          <p>具体可用的节点列表以你在客户端中看到的为准。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>可以中途换档吗？</summary>\n        <div class=\"answer\">\n          <p>可以提出申请。请说明当前档位、目标档位和剩余周期，支持人员会回复可行的处理方式与差价计算口径。</p>\n          <p>本页不自行给出折算公式，避免和实际结算不一致。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>设备数量怎么算？登录多台会怎样？</summary>\n        <div class=\"answer\">\n          <p>设备数量指同一时刻在线的数量：基础版 3 台，旗舰版 5 台，团队版 20 台。</p>\n          <p>超出上限时，通常是最早登录的设备被挤出。换设备前先在旧设备上退出，能避免来回掉线。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>订阅配置可以分享给朋友吗？</summary>\n        <div class=\"answer\">\n          <p>不建议。订阅配置等同于你的账号凭证，分享出去既会占用你自己的设备位与流量，也会带来管理上的麻烦。</p>\n          <p>确实需要多人使用，直接选团队版，按人数和设备数正规开通。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>支持哪些客户端？</summary>\n        <div class=\"answer\">\n          <p>讯达不自行开发客户端。桌面端、移动端和路由器场景的做法见上面的客户端一节，具体导入入口以你所用客户端的界面为准。</p>\n          <p>安装包与固件请从对应项目的官方渠道获取，本页不提供下载链接。</p>\n        </div>\n      </details>\n\n      <details>\n        <summary>页面和实际情况不一致怎么办？</summary>\n        <div class=\"answer\">\n          <p>以你实际开通时确认的条款为准。页面上没有写的内容，本页不作承诺。</p>\n          <p>遇到疑问，请直接联系支持人员描述具体现象，比自行推测更快得到答复。</p>\n        </div>\n      </details>\n\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"foot-grid\">\n      <div>\n        <div class=\"foot-brand\">讯达</div>\n        <p>订阅说明与使用指南。价格、流量与设备数量以本页列出为准；未列出的事项不作承诺。</p>\n      </div>\n      <div class=\"foot-links\">\n        <a href=\"#plans\">套餐与价格</a>\n        <a href=\"#usage\">使用步骤</a>\n        <a href=\"#clients\">客户端</a>\n        <a href=\"#faq\">常见问题</a>\n      </div>\n    </div>\n  </div>\n</footer>",
